# Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL="postgresql://myuser:mypassword@localhost:5434/ndr_rescue?schema=public"

# Bolna AI
BOLNA_API_KEY="your-bolna-api-key-here"
BOLNA_AGENT_ID="your-agent-id-after-setup"
# Optional: set this when your Bolna account has a rented/connected sender number
BOLNA_FROM_PHONE_NUMBER="+19876543210"

# App URL (use ngrok URL for local webhook testing, Vercel URL in production)
APP_URL="http://localhost:3000"

# Auth
JWT_SECRET="change-this-to-a-random-32-character-string"

# Webhook security
WEBHOOK_SECRET="my-super-secret-webhook-key"

# Fallback ladder
# After a no-answer webhook, the app schedules one retry by default.
NO_ANSWER_RETRY_MINUTES="15"
MAX_CALL_ATTEMPTS="2"
# Required only if you expose POST /api/recovery/retry-due publicly as a cron endpoint.
CRON_SECRET="change-this-cron-secret"

# Optional Twilio follow-up provider
# Twilio trial supports demo SMS/WhatsApp with restrictions such as verified recipients/sandbox setup.
FOLLOWUP_CHANNELS="sms,whatsapp"
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_SMS_FROM="+12345678900"
# Optional alternative to TWILIO_SMS_FROM for production SMS
TWILIO_MESSAGING_SERVICE_SID=""
# For Twilio WhatsApp Sandbox this is usually whatsapp:+14155238886
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
